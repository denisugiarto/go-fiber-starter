# Salin ke .env (jangan di-commit). Ganti semua nilai contoh.
APP_ENV=development
PORT=8080
# Dipakai docker compose
DB_PASSWORD=ganti-password-db
# Dipakai saat menjalankan langsung (make run)
DATABASE_URL=postgres://app:ganti-password-db@localhost:5432/app?sslmode=disable
# Minimal 32 karakter acak, mis. hasil: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=24h
CORS_ORIGINS=http://localhost:3000
